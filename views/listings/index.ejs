      <button>Create New Listing</button>
    </form> -->
<!-- ADD THIS — Filters bar -->
<div class="filter-bar d-flex overflow-auto py-3 mb-3">
    <a href="/listings" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-globe"></i>
        <p class="mb-0">All</p>
    </a>
    <a href="/listings?category=Trending" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-fire"></i>
        <p class="mb-0">Trending</p>
    </a>
    <a href="/listings?category=Rooms" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-bed"></i>
        <p class="mb-0">Rooms</p>
    </a>
    <a href="/listings?category=Mountains" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-mountain"></i>
        <p class="mb-0">Mountains</p>
    </a>
    <a href="/listings?category=Pools" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-water-ladder"></i>
        <p class="mb-0">Pools</p>
    </a>
    <a href="/listings?category=Beach" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p class="mb-0">Beach</p>
    </a>
    <a href="/listings?category=Castles" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-chess-rook"></i>
        <p class="mb-0">Castles</p>
    </a>
    <a href="/listings?category=Camping" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-campground"></i>
        <p class="mb-0">Camping</p>
    </a>
    <a href="/listings?category=Farms" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-cow"></i>
        <p class="mb-0">Farms</p>
    </a>
    <a href="/listings?category=Arctic" class="filter text-center mx-3 text-decoration-none text-dark">
        <i class="fa-solid fa-snowflake"></i>
        <p class="mb-0">Arctic</p>
    </a>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for (let list of allListings) { %>
    <div class="col">
      <a href="/listings/<%= list._id %>" class="listing-link">
        <div class="card" style="width: 20rem;">
          <img src="<%= list.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
          <div class="card-img-overlay"></div>
         <p class="card-text">
    <b><%= list.title %></b> <br/>
    <span class="price"> &#8377; <%= list.price ? list.price.toLocaleString("en-IN") : "N/A" %> / night</span>
    <span class="taxToggleText"> &#8377; <%= list.price ? Math.round(list.price * 1.18).toLocaleString("en-IN") : "N/A" %> / night, with taxes</span>
</p>
        </div>
      </a>
    </div>
  <% } %>
</div>






